# Copy to docker/.env (gitignored) and fill in. docker compose reads it automatically.
# Binance keys do NOT go here: demo keys go in the file named by DEMO_ENV_FILE (chmod 600, outside git).

# Files written to the bind mount get this owner. Use the output of `id -u` / `id -g`.
RB_UID=1000
RB_GID=1000

# Grafana admin password (required). Grafana listens on 127.0.0.1:3000 only.
GRAFANA_ADMIN_PASSWORD=

# Telegram bot #1: shadow. Optional; alerts are always written to logs/alerts.log too.
SHADOW_TELEGRAM_BOT_TOKEN=
SHADOW_TELEGRAM_CHAT_ID=

# Demo secrets file with BINANCE_API_KEY, BINANCE_API_SECRET (DEMO keys) and TELEGRAM_BOT_TOKEN /
# TELEGRAM_CHAT_ID (bot #2, not the shadow bot). Absolute path is safest.
DEMO_ENV_FILE=/home/riverbank/.riverbank/demo.env

# M1 validation run size
M1_SYMBOLS=20
M1_HOURS=25
